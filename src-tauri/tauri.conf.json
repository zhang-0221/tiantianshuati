{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "喜刷刷",
  "version": "0.1.0",
  "identifier": "com.yon.tiantianshuati",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "windows": [
      {
        "title": "喜刷刷",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"]
      }
    }
  }
}
